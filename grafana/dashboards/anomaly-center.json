{
  "dashboard": {
    "id": null,
    "uid": "anomaly-center",
    "title": "Anomaly Center",
    "tags": ["payments", "anomalies", "alerting"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Active Anomalies",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT count(*) FROM payments.anomaly_events WHERE resolved = false AND detected_at >= now() - INTERVAL 4 HOUR",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "P0 Incidents (24h)",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT count(*) FROM payments.anomaly_events WHERE severity = 'P0' AND detected_at >= now() - INTERVAL 24 HOUR",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "red"}
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Avg Resolution Time",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT avg(duration_seconds) / 60 AS avg_minutes FROM payments.anomaly_events WHERE resolved = true AND detected_at >= now() - INTERVAL 7 DAY",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "m"
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "False Positive Rate",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT countIf(type LIKE '%suppressed%') * 100.0 / count(*) AS fp_rate FROM payments.anomaly_events WHERE detected_at >= now() - INTERVAL 7 DAY",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 5,
        "type": "table",
        "title": "Active Anomalies",
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 4},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT detected_at, severity, type, metric, merchant_id, gateway, current_value, baseline_value, round(deviation, 2) AS deviation_pct FROM payments.anomaly_events WHERE resolved = false ORDER BY detected_at DESC LIMIT 50",
            "format": "table"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "detected_at", "desc": true}]
        },
        "columnStyles": [
          {
            "pattern": "severity",
            "type": "string",
            "colorMode": "background",
            "colors": [
              {"value": "P0", "color": "#d44a3a"},
              {"value": "P1", "color": "#f2994a"},
              {"value": "P2", "color": "#f2c94c"},
              {"value": "P3", "color": "#b2b2b2"}
            ]
          }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Anomaly Count Over Time",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT toStartOfHour(detected_at) AS hour, count(*) AS anomaly_count FROM payments.anomaly_events WHERE detected_at >= now() - INTERVAL 7 DAY GROUP BY hour ORDER BY hour ASC",
            "format": "time_series",
            "timeColumn": "hour",
            "valueColumn": "anomaly_count"
          }
        ]
      },
      {
        "id": 7,
        "type": "piechart",
        "title": "Anomalies by Type",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT type, count(*) AS count FROM payments.anomaly_events WHERE detected_at >= now() - INTERVAL 7 DAY GROUP BY type",
            "format": "table"
          }
        ]
      },
      {
        "id": 8,
        "type": "piechart",
        "title": "Anomalies by Severity",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT severity, count(*) AS count FROM payments.anomaly_events WHERE detected_at >= now() - INTERVAL 7 DAY GROUP BY severity",
            "format": "table"
          }
        ]
      },
      {
        "id": 9,
        "type": "table",
        "title": "Resolved Anomalies (Last 24h)",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
        "targets": [
          {
            "datasource": {"type": "vertamedia-clickhouse-datasource", "uid": "clickhouse"},
            "query": "SELECT detected_at, severity, metric, merchant_id, gateway, duration_seconds, round(current_value, 2) AS current, round(baseline_value, 2) AS baseline FROM payments.anomaly_events WHERE resolved = true AND detected_at >= now() - INTERVAL 24 HOUR ORDER BY detected_at DESC LIMIT 20",
            "format": "table"
          }
        ]
      }
    ],
    "time": {"from": "now-6h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
